{
  "info": {
    "name": "DIX Maillots TP3",
    "description": "TP3 test requests. Run npm run dev first. Send the requests in order (01 to 15). Each request has a green/red status check. Take one screenshot per request (method, URL, body/auth and the response with its status code). Folder E (rate limit) and F (OAuth2) are done last.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "email",
      "value": "amel@test.com"
    },
    {
      "key": "password",
      "value": "secret123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "newProductId",
      "value": ""
    },
    {
      "key": "googleToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A. Authentication",
      "item": [
        {
          "name": "01 Register new user (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has no password', function () { pm.expect(pm.response.text()).to.not.include('passwordHash'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amel\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "If you already registered this email you will get 409. Change the \"email\" collection variable (for example amel2@test.com) to repeat this test."
          }
        },
        {
          "name": "02 Register duplicate email (409)",
